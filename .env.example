APP_NAME=Courtly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courtly
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# No Redis — file cache + file session (the app has its own `sessions` table)
QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=1440

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Courtly"

# Comma-separated list of domains allowed to authenticate the Vue SPA via the
# session cookie. Must include your local dev host and your production domain.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,localhost,127.0.0.1,::1,courtly.laravel.cloud

# Social login (Google) — optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev. For production use https://courtly.laravel.cloud/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
