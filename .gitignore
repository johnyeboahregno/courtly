# Dependencies (managed via Composer — not committed)
/vendor
/node_modules

# Local Composer binary — machine-specific. CI and the production Docker image
# both use the official `composer:2` image, so this is never needed on the VPS.
/composer.phar

# Environment — never commit real secrets.
# Covers .env, .env.local, .env.production, .env.*.local, etc. Only the two
# tracked templates ship: .env.example (local) and .env.docker.example (VPS).
/.env*
!/.env.example
!/.env.docker.example

# Local SQLite database — local dev only. Production uses the MySQL container.
/database/*.sqlite
/database/*.sqlite-journal

# Playwright (browser E2E) output
/playwright-report
/test-results

# Logs
*.log
/storage/logs/*

# Runtime cache (auto-regenerated by Laravel)
/bootstrap/cache/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

# OS / editor
.DS_Store
Thumbs.db
/.idea
/.vscode/*
/.vs/
