# Copy this to .env on the OVH VPS and fill in real values.
# docker-compose reads this same file for both the MySQL container's
# credentials (${DB_...} substitution) and as Laravel's own .env
# (mounted/env_file'd into the app + queue containers).

APP_NAME=Courtly
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show (generate a NEW key, don't reuse Laravel Cloud's)
APP_DEBUG=false
APP_URL=https://badminton.courtly.win

# DB_HOST must be the compose service name, not a hostname/IP — the app
# reaches MySQL over the compose network, not the public internet.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=courtly
DB_USERNAME=courtly
DB_PASSWORD=                      # app user password — set this
DB_ROOT_PASSWORD=                 # separate root password — used only by the mysql container's healthcheck
DB_CHARSET=utf8mb4

# No Redis — database queue + file cache instead
QUEUE_CONNECTION=database
CACHE_DRIVER=file
# Stays file, not database: this app's own `sessions` table already owns that
# name, so Laravel's session table can't share it. storage/ is persisted on
# the storage_data volume specifically so file sessions survive redeploys.
SESSION_DRIVER=file
SESSION_LIFETIME=1440

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Courtly"

SANCTUM_STATEFUL_DOMAINS=badminton.courtly.win

# Social login (Google) — register this exact callback URL in Google Cloud
# Console once the domain is live: https://badminton.courtly.win/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
